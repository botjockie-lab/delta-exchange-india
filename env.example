# Delta Exchange API Credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange

# Trading Parameters
TAKE_PROFIT_PERCENT=30
STOP_LOSS_PERCENT=5
POSITION_SIZE=1
MAX_POSITIONS=4
OPTION_TYPE=BOTH
MIN_OPTION_PRICE=50
MIN_RR=2.0
TARGET_EXPIRY=DD-MM-YYYY

# Technical Indicators
ADX_THRESHOLD=20
USE_ADX_FILTER=False
ADX_PERIOD=14
BB_PERIOD=10
BB_STD_DEV=3.0
EMA_PERIOD=200
USE_EMA_FILTER=False

# Strategy Settings
CYCLE_INTERVAL=60
MOCK_MODE=False
RESOLUTION=1m
SIGNAL_EXPIRY_BARS=20

# ── Exit logic ────────────────────────────────────────────────────────────────
# TP_MODE: 'fixed' uses TAKE_PROFIT_PERCENT; 'upper_band' targets the signal-time
# upper Bollinger Band (the level the MIN_RR gate already measures reward to).
TP_MODE=fixed
# Time stop: exit at bar close after this many bars in a trade (0 = off).
MAX_BARS_IN_TRADE=0
# Trailing stop: once price reaches +TRAIL_ACTIVATION_PCT above entry, trail the
# stop TRAIL_STOP_PCT below the running peak. 0/0 = trailing off (static bracket).
# 10/10 looked good on one 9-day sample (120626) but failed out-of-sample on two
# other expiries (130626, 190626) — see notes in optimizer.py. Leave off.
TRAIL_ACTIVATION_PCT=0
TRAIL_STOP_PCT=0

# ── Signal filters (off by default; unvalidated — failed out-of-sample, see
#    optimizer.py notes) ──────────────────────────────────────────────────────
REQUIRE_STRONG_BODY=False
REQUIRE_STRONG_BOUNCE=False
# Skip new signals when fewer than this many hours remain to expiry (0 = off).
MIN_HOURS_TO_EXPIRY=0
# Direction-aware spot confirmation: require BTC spot stretched in the faded
# direction before entering (PUT→spot high, CALL→spot low).
USE_SPOT_FILTER=False
SPOT_BB_PERIOD=20
SPOT_BB_STD=2.0
